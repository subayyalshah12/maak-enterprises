# Local development only. Copy this file to .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave blank until the company creates its Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enables clearly labelled, volatile admin demo data only when NODE_ENV is not production.
MAAK_DEMO_MODE=true

# Optional division-specific WhatsApp destinations (international digits only, no + or spaces).
# Leave blank until MAAK confirms the official numbers. Buttons remain hidden while blank.
NEXT_PUBLIC_WHATSAPP_GENERAL=
NEXT_PUBLIC_WHATSAPP_REAL_ESTATE=
NEXT_PUBLIC_WHATSAPP_CONSTRUCTION=
NEXT_PUBLIC_WHATSAPP_EDUCATION=
